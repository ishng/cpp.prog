/* CMATH */
void cmath() {
    double num1,num2,num3;
    cout << "-----CMATH-----" << endl;
    cin.ignore();
    cout << "Enter First Number: ";
    cin >> num1;
    cout << "Enter Second Number: ";
    cin >> num2;
    cout << "Enter Third Number: ";
    cin >> num3;

    system("clear");
    cout << "--------GIVEN---------" << endl;
    cout << "1. " << num1 << endl;
    cout << "2. " << num2 << endl;
    cout << "3. " << num3 << endl;

    cout << "-----SQUARE ROOTS-----" << endl;
    cout << "1. " << sqrt(num1) << endl;
    cout << "2. " << sqrt(num2) << endl;
    cout << "3. " << sqrt(num3) << endl;

    cout << "----ROUNDED VALUES----" << endl;
    cout << "1. " << round(num1) << endl;
    cout << "2. " << round(num2) << endl;
    cout << "3. " << round(num3) << endl;

    cout << "---NATURAL LOGARITHM--" << endl;
    cout << "1. " << log(num1) << endl;
    cout << "2. " << log(num2) << endl;
    cout << "3. " << log(num3) << endl;

    double maxNum = max(num1,max(num2,num3));
    double minNum = min(num1,min(num2,num3));

    cout << "MAXIMUM VALUE: " << maxNum << endl;
    cout << "MINIMUM VALUE: " << minNum << endl;

    cout << endl << "Press Enter To Return";
    cin.ignore();
    cin.get();
    system("clear");
}

