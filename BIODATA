/* CALCULATOR */
void calculator() {
    double firstnum, secondnum, result;
    char operand;

    while (true) {
        cout << "-----CALCULATOR-----" << endl;
        cout << "Enter First Number: ";
        if (cin >> firstnum) break;

        cin.clear();
        cin.ignore(1000, '\n');
        system("clear");
        cout << "Invalid Input!" << endl;
    }

    system("clear");

    while (true) {
        cout << "Enter an Operator (+ - * /): ";
        cin >> operand;
        if (operand == '+' || operand == '-' || operand == '*' || operand == '/') break;

        cin.clear();
        cin.ignore(1000, '\n');
        system("clear");
        cout << "Invalid Operator!" << endl;
    }

    system("clear");

    while (true) {
        cout << "Enter Second Number: ";
        if (cin >> secondnum && !(operand == '/' && secondnum == 0)) break;

        cin.clear();
        cin.ignore(1000, '\n');
        system("clear");
        cout << "Invalid or Division by Zero!" << endl;
    }

    switch (operand) {
        case '+': result = firstnum + secondnum; break;
        case '-': result = firstnum - secondnum; break;
        case '*': result = firstnum * secondnum; break;
        case '/': result = firstnum / secondnum; break;
    }

    system("clear");
    cout << "-----RESULT-----" << endl;
    cout << firstnum << " " << operand << " " << secondnum << " = " << result << endl;

    cout << endl << "Press Enter To Return";
    cin.ignore();
    cin.get();
    system("clear");
}

