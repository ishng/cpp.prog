/* CMATH PROGRAM */
void cmathProgram() {
    double num1, num2, num3;

    cin.ignore();
    cout << "-----CMATH PROGRAM-----" << endl;

    cout << "Enter First Number: ";
    cin >> num1;
    cout << "Enter Second Number: ";
    cin >> num2;
    cout << "Enter Third Number: ";
    cin >> num3;

    system("clear");

    cout << "--------GIVEN--------" << endl;
    cout << num1 << ", " << num2 << ", " << num3 << endl;

    cout << "-----SQUARE ROOTS-----" << endl;
    cout << sqrt(num1) << ", " << sqrt(num2) << ", " << sqrt(num3) << endl;

    cout << "----ROUNDED VALUES----" << endl;
    cout << round(num1) << ", " << round(num2) << ", " << round(num3) << endl;

    cout << "---NATURAL LOGARITHM--" << endl;
    cout << log(num1) << ", " << log(num2) << ", " << log(num3) << endl;

    cout << "MAX VALUE: " << max(num1, max(num2, num3)) << endl;
    cout << "MIN VALUE: " << min(num1, min(num2, num3)) << endl;

    cout << endl << "Press Enter To Return";
    cin.ignore();
    cin.get();
    system("clear");
}

/* EVEN OR ODD */
void evenorodd() {
    int num;

    while (true) {
        cout << "-----EVEN OR ODD-----" << endl;
        cout << "Enter a non-negative whole number: ";
        if (cin >> num && num >= 0) break;

        cin.clear();
        cin.ignore(1000, '\n');
        system("clear");
        cout << "Invalid Input!" << endl;
    }

    system("clear");
    cout << "-----RESULT-----" << endl;
    cout << num << ((num % 2 == 0) ? " IS EVEN" : " IS ODD") << endl;

    cout << endl << "Press Enter To Return";
    cin.ignore();
    cin.get();
    system("clear");
}

/* GRADING SYSTEM */
void gradingsystem() {
    string subjects[4] = {"MATH", "GENSOC", "CCITCOM", "CCPROG"};
    int grades[4];
    int total = 0;
    double average;

    cout << "-------GRADING SYSTEM-------" << endl;

    for (int i = 0; i < 4; i++) {
        cout << "Enter grade for " << subjects[i] << ": ";
        cin >> grades[i];
        total += grades[i];
    }

    average = total / 4.0;

    system("clear");
    cout << "-----RESULTS-----" << endl;

    for (int i = 0; i < 4; i++) {
        cout << subjects[i] << ": " << grades[i] << endl;
    }

    cout << "Average: " << average << endl;
    cout << "Status: " << (average >= 75 ? "PASSED" : "FAILED") << endl;

    cout << endl << "Press Enter To Return";
    cin.ignore();
    cin.get();
    system("clear");
}