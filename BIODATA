void cmathMenu() {
    int choice;
    double num;

    while (true) {
        system("clear");
        cout << "-----CMATH FUNCTIONS-----" << endl;
        cout << "1. Sine (sin)" << endl;
        cout << "2. Cosine (cos)" << endl;
        cout << "3. Square Root (sqrt)" << endl;
        cout << "4. Power (pow)" << endl;
        cout << "5. Back" << endl;
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 5) break;

        switch (choice) {
            case 1:
                cout << "Enter number in radians: ";
                cin >> num;
                cout << "sin(" << num << ") = " << sin(num) << endl;
                break;
            case 2:
                cout << "Enter number in radians: ";
                cin >> num;
                cout << "cos(" << num << ") = " << cos(num) << endl;
                break;
            case 3:
                cout << "Enter number: ";
                cin >> num;
                if (num >= 0)
                    cout << "sqrt(" << num << ") = " << sqrt(num) << endl;
                else
                    cout << "Cannot take square root of negative number!" << endl;
                break;
            case 4:
                double base, exp;
                cout << "Enter base: ";
                cin >> base;
                cout << "Enter exponent: ";
                cin >> exp;
                cout << base << "^" << exp << " = " << pow(base, exp) << endl;
                break;
            default:
                cout << "Invalid choice!" << endl;
                break;
        }
        cout << "Press Enter To Continue";
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
        cin.get();
    }
    system("clear");
}

void evenOrOdd() {
    int num;
    system("clear");
    cout << "-----EVEN OR ODD-----" << endl;
    cout << "Enter a number: ";
    cin >> num;

    if (num % 2 == 0)
        cout << num << " is Even." << endl;
    else
        cout << num << " is Odd." << endl;

    cout << "Press Enter To Return";
    cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
    cin.get();
    system("clear");
}

void gradingSystem() {
    int score;
    system("clear");
    cout << "-----GRADING SYSTEM-----" << endl;
    cout << "Enter score (0-100): ";
    cin >> score;

    if (score >= 90) cout << "Grade: A" << endl;
    else if (score >= 80) cout << "Grade: B" << endl;
    else if (score >= 70) cout << "Grade: C" << endl;
    else if (score >= 60) cout << "Grade: D" << endl;
    else cout << "Grade: F" << endl;

    cout << "Press Enter To Return";
    cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
    cin.get();
    system("clear");
}

